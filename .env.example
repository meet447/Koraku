# Koraku SDK — copy to .env

# --- LLM (pick one provider) ---
LLM_PROVIDER=fireworks
FIREWORKS_API_KEY=your-fireworks-key
FIREWORKS_MODEL=accounts/fireworks/models/kimi-k2p6

# Anthropic (native Messages API)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI-compatible providers (Ollama, OpenAI, Groq, vLLM, …)
# LLM_OPENAI_COMPAT_IDS=openai,groq
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Local OpenAI-compatible proxy (registers provider id "custom")
# CUSTOM_BASE_URL=http://127.0.0.1:11434/v1
# CUSTOM_MODEL=llama3.2
# LLM_PROVIDER=custom

# Or JSON provider list (see docs/LLM.md)
# LLM_OPENAI_COMPAT_JSON=[{"id":"ollama","base_url":"http://127.0.0.1:11434/v1","default_model":"llama3.2"}]

# --- Optional tools ---
EXA_API_KEY=
FIRECRAWL_API_KEY=
COMPOSIO_API_KEY=

# --- Auth for self-hosted /stream (OSS defaults: open local dev) ---
AUTH_BACKEND=none
REQUIRE_AUTH_FOR_CHAT=false
# AUTH_BACKEND=api_key
# KORAKU_API_KEY=

# --- Execution ---
DEFAULT_EXECUTION_TARGET=local
MEMORY_BACKEND=filesystem
PORT=8000

# --- Composio sub-agent (default true) ---
# COMPOSIO_SUBAGENT_MODE=true
# COMPOSIO_TOOLS_LIMIT=48
